# Copy to .env and fill in. Without a key the platform runs in offline "mock" mode.
OPENROUTER_API_KEY=sk-or-v1-...
# Any chat model on https://openrouter.ai/models (JSON-mode capable models work best)
OPENROUTER_MODEL=google/gemini-3.7-flash
# Any embedding model on OpenRouter; text-embedding-3-small handles Arabic well and is cheap
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# auto | openrouter | mock
AQAR_LLM_MODE=auto
# Reasoning models (Gemini 3.x, GPT-5, Claude with thinking) spend hidden thinking tokens from the max_tokens budget.
# This headroom is added to every request so short JSON replies are not cut off (default 2048).
AQAR_REASONING_HEADROOM=2048
# Optional: none | minimal | low | medium | high. "low" makes Gemini 3.x extraction calls faster and cheaper.
# OPENROUTER_REASONING_EFFORT=low
