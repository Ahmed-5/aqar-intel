# Copy to .env and fill in. Without a key the platform runs in offline "mock" mode.
OPENROUTER_API_KEY=sk-or-v1-...
# Any chat model on https://openrouter.ai/models (JSON-mode capable models work best)
OPENROUTER_MODEL=google/gemini-2.5-flash
# Any embedding model on OpenRouter; text-embedding-3-small handles Arabic well and is cheap
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# auto | openrouter | mock
AQAR_LLM_MODE=auto
